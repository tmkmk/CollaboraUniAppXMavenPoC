import Activity from 'android.app.Activity'
import BroadcastReceiver from 'android.content.BroadcastReceiver'
import Context from 'android.content.Context'
import Intent from 'android.content.Intent'
import IntentFilter from 'android.content.IntentFilter'
import Uri from 'android.net.Uri'
import Build from 'android.os.Build'
import File from 'java.io.File'
import UUID from 'java.util.UUID'
import UTSAndroid from 'io.dcloud.uts.UTSAndroid'
import {
  CollaboraEditorEvent,
  CollaboraEditorEventCallback,
  CollaboraOpenOptions,
  UnoArguments
} from '../interface.uts'

const ACTION_COMMAND = 'io.github.tmkmk.collabora.EDITOR_COMMAND'
const ACTION_EVENT = 'io.github.tmkmk.collabora.EDITOR_EVENT'
const EXTRA_COMMAND_JSON = 'io.github.tmkmk.collabora.COMMAND_JSON'
const EXTRA_EVENT_JSON = 'io.github.tmkmk.collabora.EVENT_JSON'
const EXTRA_USER_NAME = 'io.github.tmkmk.collabora.USER_NAME'
const EXTRA_OPEN_MODE = 'io.github.tmkmk.collabora.OPEN_MODE'
const EXTRA_WEB_OPTIONS = 'io.github.tmkmk.collabora.WEB_OPTIONS'
const EXTRA_ENABLE_TRACK_CHANGES = 'io.github.tmkmk.collabora.ENABLE_TRACK_CHANGES'

const editorListeners = new Map<string, CollaboraEditorEventCallback>()
let eventReceiver: BroadcastReceiver | null = null
let editorOpen = false

class EditorEventReceiver extends BroadcastReceiver {
  constructor() {
    super()
  }

  override onReceive(_context: Context, intent: Intent): void {
    const eventJson = intent.getStringExtra(EXTRA_EVENT_JSON)
    if (eventJson == null) return
    let event: CollaboraEditorEvent
    try {
      event = JSON.parse(eventJson) as CollaboraEditorEvent
    } catch (error) {
      console.error('无法解析编辑器事件', error)
      return
    }
    const type = event.getString('type') ?? ''
    if (type == 'ready') editorOpen = true
    if (type == 'closed') editorOpen = false
    editorListeners.forEach((callback: CollaboraEditorEventCallback) => {
      try {
        callback(event)
      } catch (error) {
        console.error('编辑器事件回调执行失败', error)
      }
    })
  }
}

function requireActivity(): Activity {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    throw new Error('当前没有可用的 Android Activity')
  }
  return activity
}

function ensureEventReceiver(context: Context): void {
  if (eventReceiver != null) return

  eventReceiver = new EditorEventReceiver()

  const filter = new IntentFilter(ACTION_EVENT)
  if (Build.VERSION.SDK_INT >= 33) {
    context.registerReceiver(eventReceiver, filter, Context.RECEIVER_NOT_EXPORTED)
  } else {
    context.registerReceiver(eventReceiver, filter)
  }
}

function sendCommandRequest(activity: Activity, request: UTSJSONObject): void {
  if (!editorOpen) {
    throw new Error('编辑器尚未就绪或已关闭，请在 ready 事件后调用')
  }
  const intent = new Intent(ACTION_COMMAND)
  intent.setPackage(activity.getPackageName())
  intent.putExtra(EXTRA_COMMAND_JSON, JSON.stringify(request))
  activity.sendBroadcast(intent)
}

function newRequestId(): string {
  return UUID.randomUUID().toString()
}

/** 打开本机可访问的 .doc 或 .docx 文件。 */
export function openDocument(options: CollaboraOpenOptions): void {
  if (options.filePath.trim().length == 0) {
    throw new Error('Word 文档地址不能为空')
  }
  const mode = options.mode ?? 'edit'
  const userName = options.userName ?? ''
  if (mode != 'edit' && mode != 'readonly' && mode != 'revision') {
    throw new Error('mode 必须是 edit、readonly 或 revision')
  }
  if (mode == 'revision' && options.enableTrackChanges == false) {
    throw new Error('revision 模式不能关闭修订跟踪')
  }
  if (mode == 'revision' && userName.trim().length == 0) {
    throw new Error('修订作者姓名不能为空')
  }

  const activity = requireActivity()
  const absolutePath = options.filePath.startsWith('/')
    ? options.filePath
    : UTSAndroid.convert2AbsFullPath(options.filePath)
  const file = new File(absolutePath)
  if (!file.exists() || !file.isFile() || !file.canRead()) {
    throw new Error('Word 文档不存在或不可读：' + absolutePath)
  }
  if (mode != 'readonly' && !file.canWrite()) {
    throw new Error('Word 文档不可写，无法保存编辑结果：' + absolutePath)
  }
  const extension = file.getName().substring(file.getName().lastIndexOf('.') + 1).toLowerCase()
  let mimeType = ''
  if (extension == 'doc') mimeType = 'application/msword'
  else if (extension == 'docx') mimeType = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
  else throw new Error('仅支持 .doc 和 .docx 文件')

  ensureEventReceiver(activity.getApplicationContext())
  editorOpen = false
  const intent = new Intent()
  intent.setClassName(activity, 'org.libreoffice.androidlib.LOActivity')
  intent.setDataAndType(Uri.fromFile(file), mimeType)
  intent.putExtra(EXTRA_USER_NAME, userName)
  intent.putExtra(EXTRA_OPEN_MODE, mode)
  intent.putExtra(EXTRA_WEB_OPTIONS, options.webOptions == null ? '{}' : JSON.stringify(options.webOptions))
  intent.putExtra(EXTRA_ENABLE_TRACK_CHANGES, mode == 'revision' || options.enableTrackChanges == true)
  activity.startActivity(intent)
}

/** 发送 Writer UNO 命令，返回请求 ID；命令是否成功由具体命令决定。 */
export function executeUnoCommand(command: string, args?: UnoArguments, force?: boolean): string {
  if (!command.startsWith('.uno:') || command.length <= 5) {
    throw new Error('command 必须是有效的 .uno: 命令')
  }
  const requestId = newRequestId()
  sendCommandRequest(requireActivity(), {
    action: 'command',
    requestId: requestId,
    command: command,
    args: args ?? {},
    force: force == true
  })
  return requestId
}

/** 在当前光标位置插入文本。 */
export function insertText(text: string): string {
  return executeUnoCommand('.uno:InsertText', {
    Text: { type: 'string', value: text }
  }, false)
}

/** 将文档中所有匹配文本替换为新文本。 */
export function replaceText(searchText: string, replaceText: string): string {
  if (searchText.length == 0) throw new Error('searchText 不能为空')
  return executeUnoCommand('.uno:ReplaceAll', {
    SearchString: { type: 'string', value: searchText },
    ReplaceString: { type: 'string', value: replaceText }
  }, false)
}

/** 保存当前文档；保存完成后触发 saveCompleted 事件。 */
export function saveDocument(): string {
  const requestId = newRequestId()
  sendCommandRequest(requireActivity(), { action: 'save', requestId: requestId })
  return requestId
}

/** 保存并关闭当前编辑器；保存成功后关闭。 */
export function closeDocument(): string {
  const requestId = newRequestId()
  sendCommandRequest(requireActivity(), { action: 'close', requestId: requestId, saveChanges: true })
  return requestId
}

/** 订阅编辑器状态事件，返回可用于 offEditorEvent 的监听器 ID。 */
export function onEditorEvent(callback: CollaboraEditorEventCallback): string {
  ensureEventReceiver(requireActivity().getApplicationContext())
  const listenerId = newRequestId()
  editorListeners.set(listenerId, callback)
  return listenerId
}

/** 取消事件订阅。 */
export function offEditorEvent(listenerId: string): void {
  editorListeners.delete(listenerId)
}
