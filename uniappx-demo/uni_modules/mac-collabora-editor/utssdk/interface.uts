export type CollaboraOpenMode = 'edit' | 'readonly' | 'revision'

export type CollaboraOpenOptions = {
  filePath: string
  /** Original SAF content:// URI; the plugin writes the saved cache file back to this URI. */
  sourceUri?: string
  userName?: string
  mode?: CollaboraOpenMode
  webOptions?: UTSJSONObject
  enableTrackChanges?: boolean
}

/** HTTPS directory prefix containing the published runtime ZIP. */
export type CollaboraRuntimeOptions = {
  resourceBaseUrl: string
}

export type UnoValue = {
  type: string
  value: string | number | boolean
}

export type UnoArguments = UTSJSONObject

export type CollaboraEditorEvent = UTSJSONObject
export type CollaboraEditorEventCallback = (event: CollaboraEditorEvent) => void
